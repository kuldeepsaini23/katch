{
  "manifest_version": 3,
  "name": "Katch Download Manager",
  "version": "2.0.0",
  "description": "Sends downloads, videos and images to the Katch desktop app.",
  "permissions": ["downloads", "storage", "contextMenus", "cookies", "webRequest", "scripting", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Katch", "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" } },
  "options_ui": { "page": "options.html" },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["catch-rules.js", "quality.js", "pill.js", "site-toggle.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
